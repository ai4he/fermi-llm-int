# Webapp progress streams and session caches written at runtime
webapp/*.log
webapp/sessions/

# Hugging Face cache (very large; never commit)
huggingface_cache/
.cache/

# OS noise
.DS_Store
Thumbs.db

# Editor noise
.vscode/
.idea/
*.swp
*~

# Internal working material: lives in the private research repo, not here
feedbacks.docx
FEEDBACK.md
lora_repro/

# Codex CLI scratch working dir (read-only sandbox; never contains real files)
.codex_scratch/

# Local plugin drop-in directory: site plugins live here, and the examples
