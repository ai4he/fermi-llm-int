#!/usr/bin/env bash
# Source this file before launching the web server to point the components at
# custom locations. Every variable here has a sensible default (see the README);
# you only need to override the ones that do not match your system.
#
#     cp configs/env.sh.example configs/env.sh
#     # edit configs/env.sh
#     source configs/env.sh
#     ./scripts/run_webapp.sh

# Where this checkout lives. Defaults to one level above webapp/.
# export FERMI_LLM_PROJECT_DIR="$(pwd)"

# Where Hugging Face model snapshots are cached on disk.
# export FERMI_LLM_CACHE_DIR="$HOME/.cache/huggingface"

# Where vLLM's virtual environment lives, if you build one for local serving.
# export FERMI_LLM_VLLM_DIR="$HOME/.cache/vllm"

# Path to a JSON file holding one or more Google Gemini API keys
# (see configs/gemini_keys.json.example).
# export FERMI_LLM_GEMINI_KEYS_FILE="$FERMI_LLM_PROJECT_DIR/configs/gemini_keys.json"

# Path to a single-line file with a bearer token for the Clemson RCD vLLM
# endpoint, if you have access. Optional.
# export FERMI_LLM_CLEMSON_KEY_FILE="$FERMI_LLM_PROJECT_DIR/configs/clemson_vllm_key.txt"

# Conda environment for Fermi-LAT science tools (must be on $PATH or activated
# before running the pipeline). Defaults to "fermi-llm".
# export FERMI_LLM_CONDA_ENV="fermi-llm"
